{
  "name": "pxve-api",
  "version": "1.9.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#services/*": "./src/services/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts --dev",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "node --env-file-if-exists=.env --test \"tests/**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "bump-version": "node --env-file-if-exists=.env scripts/bump-version.ts",
    "manage-cache": "node --env-file-if-exists=.env scripts/cache-manage.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/swagger-ui": "0.5.3",
    "@scalar/hono-api-reference": "0.9.34",
    "await-lock": "2.2.2",
    "bing-translate-api": "^4.3.0",
    "cheerio": "1.1.2",
    "cookie": "1.1.1",
    "crypto-js": "4.2.0",
    "dayjs": "1.11.19",
    "google-translate-api-x": "^10.7.3",
    "hono": "^4.13.13",
    "hono-zod-openapi": "1.0.1",
    "isbot": "^5.2.2",
    "qrcode": "1.5.4",
    "qs": "^6.16.0",
    "sharp": "^0.35.5",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@types/crypto-js": "4.2.2",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/qs": "^6.15.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
