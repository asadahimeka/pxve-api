{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "pnpm dev",
      "options": { "cwd": "${workspaceFolder}" },
      "label": "node: dev",
      "detail": "$ node --env-file-if-exists=.env --watch src/server.ts --dev"
    },
    {
      "type": "shell",
      "command": "pnpm start",
      "options": { "cwd": "${workspaceFolder}" },
      "label": "node: start",
      "detail": "$ node --env-file-if-exists=.env src/server.ts"
    },
    {
      "type": "shell",
      "command": "pnpm test",
      "options": { "cwd": "${workspaceFolder}" },
      "label": "node: test",
      "detail": "$ node --env-file-if-exists=.env --test \"tests/**/*.test.ts\""
    }
  ]
}
